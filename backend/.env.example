# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API
# Include your deployed dashboard URL in production, e.g.
# CORS_ORIGINS=https://admin.yourdomain.com,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Auth — replace both secrets before deploying anywhere
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional: shared secret for GoHighLevel webhooks (send as header x-webhook-secret)
# GHL_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Branding in invite emails
APP_NAME=Unleash Your Brave

# Hostinger SMTP (invite / event emails). Leave blank to skip sending locally.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-mailbox-password
SMTP_FROM=you@yourdomain.com

# How long GHL invite codes stay valid
INVITE_CODE_TTL_DAYS=7

# MongoDB (local default). For production use Atlas, e.g.
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/unleash_your_brave
MONGODB_URI=mongodb://127.0.0.1:27017/unleash_your_brave

# Firebase Cloud Messaging (required for Android/iOS push)
# Prefer JSON string in App Runner; use a file path for local development.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
